{:paths ["src"]

 ;; Provider libraries are optional at graph startup: requiring jolt.crypto
 ;; selects and requires the provider for the observed target, while an
 ;; unrelated consumer can carry this library without aborting before namespace
 ;; loading. OpenSSL serves POSIX and Windows CNG ships in bcrypt.dll. libssl is
 ;; intentionally not owned here; TLS consumers declare it themselves.
 :jolt/native [{:name "crypto"
                :optional true
                :darwin ["/opt/homebrew/opt/openssl@3/lib/libcrypto.dylib"
                         "/opt/homebrew/lib/libcrypto.dylib"
                         "/usr/local/opt/openssl@3/lib/libcrypto.dylib"
                         "/usr/lib/libcrypto.dylib" "libcrypto.dylib"]
                :linux  ["libcrypto.so.3" "libcrypto.so.1.1" "libcrypto.so"]}
               {:name "bcrypt"
                :optional true
                :windows ["bcrypt.dll"]}]

 :aliases {:test {:extra-paths ["test"]
                  :extra-deps
                  {io.github.casselc/jolt-bytes
                   {:git/url "https://github.com/casselc/jolt-bytes.git"
                    :git/sha "c34b4d2275240a1efc7630f94cf97880cb905cc9"}}
                  :main-opts ["-m" "jolt.crypto-test"]}}

 :tasks {test "joltc -M:test"}}
